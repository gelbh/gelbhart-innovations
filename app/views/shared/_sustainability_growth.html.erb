<svg class="sus-growth" viewBox="0 0 120 520" role="presentation" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="sus-node-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#2f9e5b" stop-opacity="0.45" />
      <stop offset="100%" stop-color="#2f9e5b" stop-opacity="0" />
    </radialGradient>
    <filter id="sus-growth-glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  <g class="sus-growth__sprout" transform="translate(60 34)">
    <path d="M 0 14 C -16 6 -20 -10 -4 -16 C 0 -2 0 6 0 14 Z"
          fill="#2f9e5b" fill-opacity="0.14" stroke="currentColor" stroke-width="1.5" />
    <path d="M 0 14 C 16 6 20 -10 4 -16 C 0 -2 0 6 0 14 Z"
          fill="#2f9e5b" fill-opacity="0.14" stroke="currentColor" stroke-width="1.5" />
    <line x1="0" y1="14" x2="0" y2="26" stroke="currentColor" stroke-width="1.25" opacity="0.4" />
  </g>

  <path class="sus-growth__track"
        d="M 60 72 L 60 500"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        opacity="0.12" />

  <path class="sus-growth__progress"
        data-service-journey-target="progressPath"
        d="M 60 72 L 60 500"
        fill="none"
        stroke="#2f9e5b"
        stroke-width="3"
        stroke-linecap="round"
        filter="url(#sus-growth-glow)" />

  <% node_positions = [100, 196, 292, 388, 484] %>
  <% node_positions.each_with_index do |y, index| %>
    <% leaf_dir = index.even? ? 1 : -1 %>
    <g class="sus-growth__node" data-stage-node="<%= index %>">
      <circle cx="60" cy="<%= y %>" r="14" fill="url(#sus-node-glow)" class="sus-growth__node-halo" />
      <path class="sus-growth__leaf"
            d="M 60 <%= y %>
               C <%= 60 + (24 * leaf_dir) %> <%= y - 10 %>, <%= 60 + (24 * leaf_dir) %> <%= y - 22 %>, <%= 60 + (6 * leaf_dir) %> <%= y - 26 %>
               C <%= 60 + (4 * leaf_dir) %> <%= y - 12 %>, <%= 60 + (12 * leaf_dir) %> <%= y - 6 %>, 60 <%= y %> Z" />
      <circle cx="60" cy="<%= y %>" r="6" class="sus-growth__node-core" />
    </g>
  <% end %>
</svg>
