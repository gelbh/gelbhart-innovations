<%= render "shared/jarallax" %>

<div class="bg-secondary services-hub__canvas-host" data-controller="atelier-field">
  <canvas class="services-hub__field" data-atelier-field-target="canvas" aria-hidden="true"></canvas>

  <%= render "shared/breadcrumb" %>

  <section class="services-hub container py-2 pb-md-5 px-3 px-sm-4">
    <header class="services-hub__header mx-auto text-center mb-4 mb-md-5">
      <h1 class="services-hub__heading display-6 fw-bold mb-3"><%= t("pages.services.title") %></h1>
      <p class="services-hub__lead text-body fs-5 mb-0"><%= t("pages.services.intro_lead") %></p>
    </header>

    <div class="services-hub__grid" data-controller="tile-field">
      <% [
        [:pharmaceutical, pharmaceutical_path],
        [:real_estate, real_estate_path],
        [:full_stack, full_stack_path],
        [:sustainability, sustainability_path]
      ].each_with_index do |(key, path), index| %>
        <%= render "shared/services_offering_tile",
                   title: t("pages.services.#{key}.title"),
                   eyebrow: t("pages.services.#{key}.subtitle"),
                   body: t("pages.services.#{key}.description"),
                   icon: AppConstants::SERVICE_ICONS[key],
                   gradient: AppConstants::SERVICE_GRADIENTS[key],
                   accent_rgb: AppConstants::SERVICE_ACCENT_RGB[key],
                   practice: key,
                   tile_index: index,
                   href: path,
                   wrapper_options: { data: { turbo_preload: true, tile_field_target: "tile" } } %>
      <% end %>
    </div>
  </section>
</div>
