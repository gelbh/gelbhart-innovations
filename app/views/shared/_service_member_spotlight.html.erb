<%# locals: member, heading_id, i18n_scope, primary_btn_class, bio_text (optional), wrapper_class %>
<% member = local_assigns.fetch(:member) %>
<% heading_id = local_assigns.fetch(:heading_id) %>
<% i18n_scope = local_assigns.fetch(:i18n_scope) %>
<% primary_btn = local_assigns.fetch(:primary_btn_class, "btn-primary") %>
<% wrapper_class = local_assigns[:wrapper_class] %>

<section class="service-member-spotlight <%= wrapper_class %>" aria-labelledby="<%= heading_id %>">
  <div class="service-member-spotlight__layout">
    <figure class="service-member-spotlight__figure">
      <%= image_tag member.image_filename,
                    class: "service-member-spotlight__image",
                    alt: team_member_image_alt(member),
                    width: member.image_width,
                    height: member.image_height,
                    loading: "lazy" %>
    </figure>

    <div class="service-member-spotlight__content">
      <% if t("#{i18n_scope}.label", default: "").present? %>
        <p class="service-member-spotlight__label"><%= t("#{i18n_scope}.label") %></p>
      <% end %>

      <h2 class="service-member-spotlight__name" id="<%= heading_id %>"><%= member.name %></h2>
      <p class="service-member-spotlight__role"><%= t("#{i18n_scope}.title") %></p>

      <div class="service-member-spotlight__bio text-body">
        <% if local_assigns[:bio_text].present? %>
          <%= simple_format(local_assigns[:bio_text], {}, sanitize: true) %>
        <% else %>
          <%= service_spotlight_bio(i18n_scope, member) %>
        <% end %>
      </div>

      <div class="service-member-spotlight__actions">
        <%= link_to contact_path,
                    class: "btn #{primary_btn} service-member-spotlight__cta-primary",
                    data: { turbo_preload: true } do %>
          <%= t("#{i18n_scope}.cta_primary") %>
        <% end %>
        <% if member.linkedin? %>
          <%= link_to member.linkedin_url,
                      class: "btn btn-outline-secondary service-member-spotlight__cta-secondary",
                      target: "_blank",
                      rel: "noopener noreferrer",
                      aria: { label: t("pages.team.linkedin_aria", name: member.name) } do %>
            <%= t("#{i18n_scope}.cta_secondary") %>
          <% end %>
        <% end %>
        <% if member.github? %>
          <%= link_to member.github_url,
                      class: "btn btn-outline-secondary service-member-spotlight__cta-secondary",
                      target: "_blank",
                      rel: "noopener noreferrer",
                      aria: { label: t("pages.team.github_aria", name: member.name) } do %>
            <%= t("common.view_github_profile") %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</section>
