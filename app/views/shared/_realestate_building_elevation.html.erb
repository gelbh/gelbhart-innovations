<svg class="re-building" viewBox="0 0 220 420" role="presentation" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="re-building-grid" width="20" height="20" patternUnits="userSpaceOnUse">
      <path d="M 20 0 L 0 0 0 20" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.2" />
    </pattern>
  </defs>

  <rect x="0" y="0" width="220" height="420" fill="url(#re-building-grid)" opacity="0.5" />

  <g class="re-building__foundation" aria-hidden="true">
    <path d="M 30 380 L 190 380 L 190 400 L 30 400 Z"
          fill="rgba(0, 111, 151, 0.06)"
          stroke="currentColor"
          stroke-width="1.25"
          opacity="0.45" />
  </g>

  <% floors = [
    { y: 320, h: 52, label: "01" },
    { y: 258, h: 52, label: "02" },
    { y: 196, h: 52, label: "03" },
    { y: 134, h: 52, label: "04" },
    { y: 72, h: 52, label: "05" }
  ] %>
  <% floors.each_with_index do |floor, index| %>
    <g class="re-building__floor" data-service-journey-target="floor" data-floor="<%= index %>">
      <path class="re-building__outline"
            d="M 40 <%= floor[:y] %> L 180 <%= floor[:y] %> L 175 <%= floor[:y] + floor[:h] %> L 45 <%= floor[:y] + floor[:h] %> Z"
            fill="rgba(0, 111, 151, 0.04)"
            stroke="currentColor"
            stroke-width="1.75" />
      <line x1="45" y1="<%= floor[:y] + floor[:h] / 2 %>" x2="175" y2="<%= floor[:y] + floor[:h] / 2 %>"
            stroke="currentColor" stroke-width="0.75" opacity="0.35" stroke-dasharray="4 3" />
      <text x="210" y="<%= floor[:y] + floor[:h] / 2 + 5 %>" font-size="11" fill="currentColor" opacity="0.4" font-family="system-ui, sans-serif"><%= floor[:label] %></text>
    </g>
  <% end %>

  <path class="re-building__crane"
        d="M 185 30 L 185 70 M 185 30 L 210 30 M 185 30 L 165 50"
        fill="none"
        stroke="currentColor"
        stroke-width="1.25"
        opacity="0.35"
        stroke-linecap="round" />

  <line x1="10" y1="400" x2="210" y2="400" stroke="currentColor" stroke-width="2" opacity="0.25" />
</svg>
