<div class="sustainability-page service-journey" data-controller="service-journey">
  <%= render "shared/breadcrumb" %>

  <section class="sustainability-page__hero sustainability-page__hero--natural vt-hero">
    <div class="sustainability-page__hero-media" aria-hidden="true">
      <%= image_tag "covers/sustainability_hero.jpg",
                    class: "sustainability-page__hero-photo",
                    alt: "",
                    width: 1600,
                    height: 900,
                    loading: "eager",
                    decoding: "async" %>
      <div class="sustainability-page__hero-scrim"></div>
    </div>
    <div class="container sustainability-page__hero-inner px-3 px-sm-4">
      <%= link_to services_path, class: "sustainability-page__back btn btn-outline-light btn-sm", data: { turbo_preload: true } do %>
        <i class="bx bx-arrow-back me-1"></i><span class="d-none d-sm-inline"><%= t("pages.services.sustainability.back_button") %></span>
      <% end %>
      <p class="sustainability-page__kicker mb-2"><%= t("pages.services.sustainability.subtitle") %></p>
      <h1 class="sustainability-page__title mb-3"><%= t("pages.services.sustainability.page_title") %></h1>
      <p class="sustainability-page__lead mb-0"><%= t("pages.services.sustainability.intro") %></p>
    </div>
    <span class="visually-hidden"><%= t("pages.services.sustainability.hero_image_alt") %></span>
  </section>

  <section class="sustainability-journey container px-3 px-sm-4 pb-4 pb-lg-5"
           data-service-journey-target="track"
           aria-labelledby="sustainability-stages-title">
    <header class="sustainability-journey__header mb-4 mb-lg-5">
      <h2 class="sustainability-journey__section-title mb-0" id="sustainability-stages-title"><%= t("pages.services.sustainability.offerings_title") %></h2>
    </header>

    <div class="sustainability-journey__layout">
      <div class="sustainability-journey__graphic">
        <%= render "shared/sustainability_growth" %>
      </div>

      <ol class="sustainability-journey__stages list-unstyled mb-0">
        <% @sustainability_services.each_with_index do |service_key, index| %>
          <% scope = "pages.services.sustainability.services.#{service_key}" %>
          <li class="sustainability-journey__stage"
              data-service-journey-target="stage"
              data-stage-index="<%= index %>"
              style="--stage-index: <%= index %>;">
            <span class="sustainability-journey__index" aria-hidden="true"><%= format("%02d", index + 1) %></span>
            <article class="sustainability-journey__content">
              <h3 class="sustainability-journey__title h4 fw-bold mb-2"><%= t("#{scope}.title") %></h3>
              <p class="sustainability-journey__prompt fw-medium mb-2"><%= t("#{scope}.prompt") %></p>
              <p class="sustainability-journey__description mb-3"><%= t("#{scope}.details") %></p>
              <ul class="sustainability-journey__tags list-inline mb-0">
                <% t("#{scope}.tags").each do |tag| %>
                  <li class="list-inline-item"><span class="sustainability-journey__tag"><%= tag %></span></li>
                <% end %>
              </ul>
            </article>
          </li>
        <% end %>
      </ol>
    </div>

    <% if @sustainability_member.present? %>
      <div class="sustainability-page__spotlight-wrap pt-5 mt-2">
        <%= render "shared/service_member_spotlight",
                   member: @sustainability_member,
                   heading_id: "sustainability-member-title",
                   primary_btn_class: "btn-success",
                   i18n_scope: "pages.services.sustainability.spotlight",
                   wrapper_class: "service-member-spotlight--sustainability" %>
      </div>
    <% end %>
  </section>
</div>
