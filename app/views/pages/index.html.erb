<section class="position-relative d-flex align-items-center bg-light min-vh-100 hero-section">
  <div class="container px-3 px-sm-4">
    <div class="row justify-content-center">
      <div class="col-11 col-sm-10 col-md-8 col-lg-6 text-center mb-4 mb-sm-5">
        <%= image_tag "logo.png", alt: t('site.name') + " Logo", class: "img-fluid hero-logo", width: 547, height: 548, fetchpriority: "high" %>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-11 col-sm-10 col-md-8 col-lg-7">
        <h1 class="text-center hero-title mb-0">
          <%= t('pages.home.title') %> <span class="text-brand-signal"><%= t('pages.home.subtitle') %></span>
        </h1>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-11 col-sm-10 col-md-8 col-lg-6 pt-3 pt-sm-4">
        <h2 class="text-center hero-subtitle mb-0">
          <%= t('pages.home.tagline_line1') %> <br class="d-none d-sm-inline"> <%= t('pages.home.tagline_line2') %>
        </h2>
      </div>
    </div>
  </div>
</section>
